# CafePlay — ortam değişkenleri
#
# Bu dosya depoda durur ve YALNIZCA değişken ADLARINI içerir.
# Gerçek değerler .env.local dosyasına yazılır ve .gitignore ile dışlanır.
# Canlı ortamda hiçbir değer dosyada durmaz — sunucunun sır kasasından gelir.
#
# Kurulum:
#   cp .env.example .env.local
#   npm run keys:generate     → anahtarları üretir, ekrana basar
#
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# --- Veritabanı ---------------------------------------------------------
# Yönetici bağlantısı: YALNIZCA göç (migration) çalıştırmak için.
DATABASE_URL=postgresql://cafeplay_admin:gelistirme_ortami@localhost:5433/cafeplay

# Uygulama bağlantısı: kısıtlı rol. Satır düzeyi güvenliği (RLS) bu rolde çalışır.
# Bu rol tablo sahibi DEĞİLDİR — sahibi olsaydı RLS'yi atlardı.
APP_DATABASE_URL=postgresql://cafeplay_app:UYGULAMA_PAROLASI@localhost:5433/cafeplay

# --- Anahtarlar (docs/08 §5) --------------------------------------------
# Hepsi 32 baytlık base64. Birbirinden AYRI olmak zorunda.
# Kör indeks anahtarı sızarsa saldırgan numaranın sistemde olup olmadığını
# öğrenir ama numarayı OKUYAMAZ — tek anahtar kullanılsaydı ikisi de giderdi.

PII_ENC_KEY=
PHONE_INDEX_KEY=
OTP_PEPPER=
SESSION_HASH_KEY=
IDENTIFIER_HASH_KEY=

# G15: yedek anahtarı diğerlerinden AYRI ve ayrı yerde saklanır.
# Yedek dosyası sızarsa saldırganın elinde iki ayrı anahtar eksik kalır.
BACKUP_ENC_KEY=

# --- SMS (Faz 3) --------------------------------------------------------
# Geliştirmede kod ekrana basılır, SMS gönderilmez.
SMS_PROVIDER=console
SMS_SENDER_ID=
SMS_API_KEY=
