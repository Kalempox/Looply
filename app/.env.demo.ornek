# ═══════════════════════════════════════════════════════════
# Looply — demo sunucusu ortam değişkenleri (F3)
# ═══════════════════════════════════════════════════════════
#
# Bu dosya depoda durur ve YALNIZCA değişken adlarını taşır.
# Sunucuda kopyalanıp doldurulacak:
#
#   cp .env.demo.ornek .env.demo
#   npm run keys:generate        → altı anahtarı üretir
#   chmod 600 .env.demo
#
# 🔴 `.env.demo` depoya GİRMEZ ve imaja da girmez (.dockerignore).
#
# Compose hem kapların ortamını hem de kendi `${...}` yerine koymalarını
# bu dosyadan okuyor — bu yüzden komutlarda `--env-file .env.demo` var.
# Unutulursa ALAN_ADI boş kalır ve Caddy açılışta durur.

# ── Alan adı ve sertifika ───────────────────────────────────
# A kaydı bu sunucuya yayılmış OLMALI; yoksa Let's Encrypt sertifika vermez.
ALAN_ADI=demo.looplybusiness.com
# Sertifika süresi dolmadan uyarı bu adrese gider.
ACME_EPOSTA=

# ── Ortam ───────────────────────────────────────────────────
# 🔴 `staging` bilerek: `production` olsaydı env.ts sahte SMS sağlayıcısını
# reddeder ve uygulama hiç açılmazdı (Ü81). `staging` + `console` ile
# doğrulama kodu giriş ekranında görünüyor, gerçek SMS beklenmiyor.
#
# ⚠️ Bunun bedeli var ve bilinçli: kod ekranda görünüyorsa, adresi bilen
# herkes istediği numarayla hesap açabilir. Demo süresince adresi dar
# tutun; gerçek müşteriye açılacaksa önce SMS sağlayıcısı (K2) gelmeli.
APP_ENV=staging

# ── Veritabanı ──────────────────────────────────────────────
# Kap adı `db` — compose ağındaki servis adı. Dışarı açık port yok (K1).
#
# POSTGRES_PASSWORD: yönetici (tablo sahibi) parolası. Postgres kabı bunu
# ilk açılışta kullanıyor, DATABASE_URL'de de aynısı geçmeli.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cafeplay_admin:BURAYA_AYNI_PAROLA@db:5432/cafeplay

# 🔴 Uygulama KISITLI rolle bağlanıyor. Bu satırda `cafeplay_admin`
# yazsaydı satır düzeyi güvenliği (RLS) devre dışı kalır ve kiracı
# izolasyonunun ikinci katmanı yok olurdu — demo gerçeği göstermezdi.
# Parola kurulum sırasında `ALTER ROLE` ile atanıyor (docs/26, adım 4).
APP_DATABASE_URL=postgresql://cafeplay_app:UYGULAMA_PAROLASI@db:5432/cafeplay

# ── Anahtarlar (docs/08 §5) ─────────────────────────────────
# Altısı da 32 baytlık base64 ve birbirinden FARKLI olmak zorunda —
# env.ts açılışta kontrol ediyor. `npm run keys:generate` üretir.
#
# ⚠️ Bu anahtarlar geliştirme makinenizdekilerle AYNI OLMAMALI. Aynı
# olursa demo veritabanının dökümü, yerel anahtarlarla da çözülebilir hâle
# gelir — anahtarı iki yere birden koymuş olursunuz.
PII_ENC_KEY=
PHONE_INDEX_KEY=
EMAIL_INDEX_KEY=
OTP_PEPPER=
SESSION_HASH_KEY=
IDENTIFIER_HASH_KEY=

# G15: yedek anahtarı AYRI yerde saklanır. Demo için de öyle davranın —
# bu dosyada durursa, yedek dosyası sızdığında anahtar da onunla gider.
BACKUP_ENC_KEY=

# ── SMS ─────────────────────────────────────────────────────
# Demo boyunca sahte sağlayıcı. K2 kararı gelince burası değişecek.
SMS_PROVIDER=console
SMS_SENDER_ID=
SMS_API_KEY=

# ── E-posta (Ü170) — doğrulama kodu buradan gidiyor ─────────
# console: kod ekranda görünür, hiçbir yere gönderilmez (canlıda YASAK)
# resend : gerçek gönderim; RESEND_API_KEY zorunlu
EPOSTA_SAGLAYICI=console
RESEND_API_KEY=
# Resend'de doğrulanmış alan adı olmalı, yoksa gönderim reddedilir.
EPOSTA_GONDEREN=Looply <onboarding@resend.dev>
