{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "looply",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "app"
      ],
      "port": 3000
    },
    {
      "name": "looply-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:https",
        "--prefix",
        "app"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    },
    {
      "name": "tasarim",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs/tasarim"
      ],
      "port": 4173
    },
    {
      "name": "looply-telefon",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "telefon:baslat",
        "--prefix",
        "app"
      ],
      "port": 3001,
      "url": "https://localhost:3001"
    }
  ]
}
